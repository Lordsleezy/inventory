<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/floor_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.22"
            android:textColor="@color/floor_mute"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/floor_text"
            android:textSize="20sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <FrameLayout
            android:id="@+id/floor_button"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:background="@drawable/btn_app"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/floor_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/floor_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/floor_text"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/floor_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/floor_mute"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <FrameLayout
            android:id="@+id/square_button"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:background="@drawable/btn_app"
            android:clickable="true"
            android:focusable="true">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/floor_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/square_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/floor_text"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/square_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/floor_mute"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <FrameLayout
            android:id="@+id/blink_button"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:background="@drawable/btn_app"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/floor_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blink"
                    android:textColor="@color/floor_text"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/blink_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/floor_mute"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <FrameLayout
            android:id="@+id/browser_button"
            android:layout_width="match_parent"
            android:layout_height="128dp"
            android:background="@drawable/btn_app"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/floor_accent" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Browser"
                    android:textColor="@color/floor_text"
                    android:textSize="32sp" />

                <TextView
                    android:id="@+id/browser_hint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/floor_mute"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/motion_alarm_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_app"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="58dp"
            android:padding="12dp"
            android:textColor="@color/floor_text"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/floor_mute"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/battery"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/battery_chip"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp"
        android:paddingBottom="4dp"
        android:text="--%"
        android:textColor="@color/floor_text"
        android:textSize="14sp" />

    <View
        android:id="@+id/admin_hotspot"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_gravity="top|end"
        android:clickable="true"
        android:contentDescription="@string/admin_hotspot"
        android:focusable="true"
        android:importantForAccessibility="no" />
</FrameLayout>
