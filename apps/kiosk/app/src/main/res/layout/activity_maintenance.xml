<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/floor_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="36dp"
        android:paddingEnd="28dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.18"
            android:text="MAINTENANCE"
            android:textColor="@color/floor_mute"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/maintenance_timer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:textColor="@color/floor_text"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/action_settings"
            style="@style/FloorKioskAction"
            android:text="Settings" />

        <TextView
            android:id="@+id/action_play"
            style="@style/FloorKioskAction"
            android:text="Play Store" />

        <TextView
            android:id="@+id/action_floor"
            style="@style/FloorKioskAction"
            android:text="Floor" />

        <TextView
            android:id="@+id/action_square"
            style="@style/FloorKioskAction"
            android:text="Square" />

        <TextView
            android:id="@+id/action_pin"
            style="@style/FloorKioskAction"
            android:text="Change PIN" />

        <TextView
            android:id="@+id/action_resume"
            style="@style/FloorKioskAction"
            android:text="Resume register"
            android:textColor="@color/floor_accent" />

        <TextView
            android:id="@+id/action_relinquish"
            style="@style/FloorKioskAction"
            android:layout_marginTop="28dp"
            android:text="Remove device owner"
            android:textColor="#FF4D4D" />
    </LinearLayout>
</ScrollView>
