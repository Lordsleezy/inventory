#!/bin/bash
# Launch Floor Register, sourcing optional WebKit workarounds.
# Used by Cage (greetd kiosk) and by the desktop .desktop entry.
set -euo pipefail
if [[ -f /etc/floor-pos/webkit.env ]]; then
  # shellcheck disable=SC1091
  set -a
  source /etc/floor-pos/webkit.env
  set +a
fi
exec /usr/bin/floor-pos "$@"
