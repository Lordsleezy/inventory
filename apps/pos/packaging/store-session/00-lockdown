[org/gnome/desktop/lockdown]
disable-command-line=true
disable-user-switching=true
disable-lock-screen=true
disable-log-out=false
disable-save-to-disk=true

[org/gnome/desktop/session]
idle-delay=uint32 0

[org/gnome/desktop/screensaver]
lock-enabled=false
user-switch-enabled=false

[org/gnome/desktop/media-handling]
automount=false
automount-open=false
autorun-never=true

[org/gnome/desktop/interface]
enable-hot-corners=false

[org/gnome/mutter]
overlay-key=''
dynamic-workspaces=false

[org/gnome/mutter/wayland/keybindings]
switch-to-session-1=@as []
switch-to-session-2=@as []
switch-to-session-3=@as []
switch-to-session-4=@as []
switch-to-session-5=@as []
switch-to-session-6=@as []
switch-to-session-7=@as []
switch-to-session-8=@as []
switch-to-session-9=@as []
switch-to-session-10=@as []
switch-to-session-11=@as []
switch-to-session-12=@as []

[org/gnome/desktop/wm/keybindings]
panel-run-dialog=@as []
panel-main-menu=@as []
activate-window-menu=@as []
switch-input-source=@as []
switch-input-source-backward=@as []

[org/gnome/shell]
enabled-extensions=['floor-store@floor.local']
disabled-extensions=@as []
disable-user-extensions=false
development-tools=false
favorite-apps=['floor-pos.desktop', 'firefox_firefox.desktop']

[org/gnome/shell/keybindings]
toggle-overview=@as []
toggle-application-view=@as []
focus-active-notification=@as []
toggle-quick-settings=@as []
show-screenshot-ui=@as []

[org/gnome/settings-daemon/plugins/media-keys]
terminal=@as []
www=@as []
home=@as []
search=@as []
help=@as []
calculator=@as []
control-center=@as []
email=@as []
logout=@as []
screensaver=@as []
custom-keybindings=@as []

[org/gnome/settings-daemon/plugins/power]
power-button-action='nothing'
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='nothing'
