{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Floor Register",
  "version": "0.1.2",
  "identifier": "com.floor.register",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Floor Register",
        "fullscreen": false,
        "decorations": false,
        "resizable": true,
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": ["cage", "greetd"]
      }
    }
  }
}
