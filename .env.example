SUPABASE_URL=https://zoukmsmbztcuyoslvikp.supabase.co
VITE_SUPABASE_URL=https://zoukmsmbztcuyoslvikp.supabase.co
SUPABASE_ANON_KEY=
VITE_SUPABASE_ANON_KEY=
# Service role: PC import/export scripts and Netlify functions only. Never ship in the app.
SUPABASE_SERVICE_ROLE=
# STORE_ID=uuid-from-Setup
# eBay sandbox (Netlify functions + local .env.local). App ID / Dev ID / Cert ID from developer.ebay.com.
# EBAY_ENV=sandbox
# EBAY_CLIENT_ID=
# EBAY_DEV_ID=
# EBAY_CLIENT_SECRET=
# EBAY_RU_NAME=
# EBAY_NOTIFICATION_TOKEN=
# EBAY_NOTIFICATION_ENDPOINT=https://<functions-site>/.netlify/functions/ebay-notify
# EBAY_ORDERS_ONLY=true          # legacy global flag; selling ebay_accounts list even when true
# EBAY_REQUIRED_USERNAME=pgg124-5 # orders-only reconnect still expects this seller
# After the business account is connected as role=selling, set EBAY_ORDERS_ONLY=false in Netlify
# so legacy paths that do not pass an account also allow listing.
# STORE_ID=uuid-from-Setup
# PC scripts also read gitignored .env.local (SUPABASE_SERVICE_ROLE + STORE_ID).
# Photo cleanup (PC only). Never put these in the review page or commit them.
# CLIPDROP_API_KEY=
# PHOTOROOM_API_KEY=
# CUTOUT_PROVIDER=rembg

# Square sandbox (Netlify functions only — never VITE_ for secrets)
# From developer.squareup.com → Applications → Floor POS → Sandbox
# SQUARE_ENVIRONMENT=sandbox
# SQUARE_APPLICATION_ID=
# SQUARE_APPLICATION_SECRET=
# SQUARE_REDIRECT_URL=https://inventoryobi.netlify.app/.netlify/functions/square-oauth-callback
# CONNECTIONS_KEY=   # 64-hex or any secret; encrypts Square + eBay tokens at rest
# Google Merchant API (Netlify functions only; OAuth refresh token is secret)
# GOOGLE_MERCHANT_ENABLED=false
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_MERCHANT_ACCOUNT_ID=
# GOOGLE_DATA_SOURCE_ID=
# Optional: Default Test Account token (sandbox API without completing OAuth once)
# SQUARE_SANDBOX_ACCESS_TOKEN=
# SQUARE_SANDBOX_LOCATION_ID=   # from Sandbox → Locations (or list via square-list-locations)

# Amazon MFN returns (Reports API). Same SP-API LWA creds as amazon-sync.
# AMAZON_RETURNS_LOOKBACK_DAYS=14

# TikTok Shop Open API (US Custom app). Tokens stored encrypted in connections (provider=tiktok).
# See docs/TIKTOK_SHOP.md for redirect URL + Manage API scopes.
# TIKTOK_SHOP_APP_KEY=
# TIKTOK_SHOP_APP_SECRET=
# TIKTOK_SHOP_SERVICE_ID=          # optional Partner Center Service ID (authorize URL)
# TIKTOK_SHOP_SHOP_ID=
# TIKTOK_SHOP_API_BASE=https://open-api.tiktokglobalshop.com
# TIKTOK_SHOP_AUTH_BASE=https://auth.tiktok-shops.com
# TIKTOK_SHOP_REDIRECT_URL=https://inventoryobi.netlify.app/.netlify/functions/tiktok-oauth-callback
# TIKTOK_SHOP_ACCESS_TOKEN=        # bootstrap only; prefer OAuth → connections
# TIKTOK_SHOP_LISTING_ENABLED=0    # set 1 to allow live product push
# TIKTOK_SHOP_FEE_PCT=0.08
# TIKTOK_SHOP_WAREHOUSE_ID=        # required by product create once listing is enabled
# TIKTOK_ORDERS_LOOKBACK_DAYS=14
# TIKTOK_RETURNS_LOOKBACK_DAYS=14

